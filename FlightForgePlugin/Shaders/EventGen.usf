// event-camera pixel model, one thread per pixel; mirrored by UEventCamera::RunCpuModel

#include "/Engine/Private/Common.ush"

Texture2D<float4>         InputTexture;
RWTexture2D<float4>       StateTexture;      // x reference log, y/z low-pass stages, w last output
RWTexture2D<uint>         LastEventTexture;  // microseconds, wrapping
RWStructuredBuffer<uint2> EventBuffer;       // x: px | py << 16 | polarity << 31, y: microseconds after frame start
RWStructuredBuffer<uint>  HeaderBuffer;      // 0 events appended, 1 max |dL| as float bits

int2  Size;
float Dt;
uint  BaseUs;
uint  DtUs;
uint  MaxEvents;
uint  FrameIndex;
uint  Seed;
uint  bSeedState;

float ThresholdPos;
float ThresholdNeg;
float ThresholdSigma;
uint  RefractoryUs;
float CutoffHz;
float LeakRateHz;
float ShotNoiseRateHz;
float HotPixelFraction;
float LogEps;

/* hashing //{ */

uint Pcg(uint v)
{
	uint state = v * 747796405u + 2891336453u;
	uint word  = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
	return (word >> 22u) ^ word;
}

float Hash01(uint a, uint b, uint c)
{
	uint h = Pcg(a ^ Pcg(b ^ Pcg(c)));
	return (h & 0xFFFFFFu) / 16777216.0;
}

float Gaussian(uint a, uint b, uint c)
{
	float u1 = max(Hash01(a, b, c), 1e-7);
	float u2 = Hash01(a, b, c + 0x9E3779B9u);
	return sqrt(-2.0 * log(u1)) * cos(6.283185307 * u2);
}

//}

void Emit(uint2 P, bool bPositive, uint OffsetUs)
{
	uint Index;
	InterlockedAdd(HeaderBuffer[0], 1u, Index);
	if (Index < MaxEvents)
	{
		EventBuffer[Index] = uint2(P.x | (P.y << 16) | (bPositive ? 0x80000000u : 0u), OffsetUs);
	}
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint2 P = DispatchThreadId.xy;
	if (any(P >= uint2(Size)))
	{
		return;
	}

	const float3 Rgb     = InputTexture.Load(int3(P, 0)).rgb;
	const float  I       = max(dot(Rgb, float3(0.2126, 0.7152, 0.0722)), 0.0);
	const float  Inten01 = saturate(I);
	const float  L       = log(I + LogEps);

	if (bSeedState != 0u)
	{
		StateTexture[P]     = float4(L, L, L, L);
		LastEventTexture[P] = BaseUs - RefractoryUs;
		return;
	}

	const uint PixelKey = P.x + P.y * 65536u;

	float4 State = StateTexture[P];
	float  Ref   = State.x;
	float  Lp1   = State.y;
	float  Lp2   = State.z;
	const float LPrev = State.w;

	// photoreceptor bandwidth falls with illumination: two cascaded first-order stages
	if (CutoffHz > 0.0)
	{
		const float Alpha = 1.0 - exp(-6.283185307 * CutoffHz * lerp(0.05, 1.0, Inten01) * Dt);
		Lp1 += Alpha * (L - Lp1);
		Lp2 += Alpha * (Lp1 - Lp2);
	}
	else
	{
		Lp1 = L;
		Lp2 = L;
	}
	const float LCur = Lp2;

	// the leak drags the reference down so ON events fire at the leak rate
	Ref -= LeakRateHz * ThresholdPos * Dt * (0.9 + 0.2 * Hash01(PixelKey, Seed, 1u));

	const float Cpos = max(ThresholdPos + ThresholdSigma * Gaussian(PixelKey, Seed, 2u), 0.01);
	const float Cneg = max(ThresholdNeg + ThresholdSigma * Gaussian(PixelKey, Seed, 3u), 0.01);

	uint LastEv = LastEventTexture[P];

	const float dL = LCur - LPrev;
	InterlockedMax(HeaderBuffer[1], asuint(abs(dL)));

	// a burst cannot outrun the refractory period; past that the pixel just resets
	const uint MaxPerPixel = min(64u, RefractoryUs > 0u ? DtUs / RefractoryUs + 1u : 64u);
	uint       Emitted     = 0u;

	if (dL > 0.0)
	{
		while (Ref + Cpos <= LCur && Emitted < MaxPerPixel)
		{
			Ref += Cpos;
			const float Frac   = saturate((Ref - LPrev) / dL);
			const uint  Offset = (uint)round(Frac * DtUs);
			const uint  TUs    = BaseUs + Offset;
			if (TUs - LastEv >= RefractoryUs)
			{
				Emit(P, true, Offset);
				LastEv = TUs;
			}
			Emitted++;
		}
	}
	else if (dL < 0.0)
	{
		while (Ref - Cneg >= LCur && Emitted < MaxPerPixel)
		{
			Ref -= Cneg;
			const float Frac   = saturate((Ref - LPrev) / dL);
			const uint  Offset = (uint)round(Frac * DtUs);
			const uint  TUs    = BaseUs + Offset;
			if (TUs - LastEv >= RefractoryUs)
			{
				Emit(P, false, Offset);
				LastEv = TUs;
			}
			Emitted++;
		}
	}

	if (Emitted >= MaxPerPixel)
	{
		Ref = LCur;
	}

	// shot noise: up to 4x the base rate in the dark, 100x on hot pixels
	if (ShotNoiseRateHz > 0.0)
	{
		float Rate = ShotNoiseRateHz * (1.0 + 3.0 * (1.0 - Inten01));
		if (Hash01(PixelKey, Seed, 4u) < HotPixelFraction)
		{
			Rate *= 100.0;
		}

		const float U = Hash01(PixelKey, Seed ^ (FrameIndex * 0x85EBCA6Bu), 5u);
		if (U < Rate * Dt)
		{
			const float V      = Hash01(PixelKey, Seed ^ (FrameIndex * 0xC2B2AE35u), 6u);
			const uint  Offset = (uint)(V * DtUs);
			const uint  TUs    = BaseUs + Offset;
			if (TUs - LastEv >= RefractoryUs)
			{
				Emit(P, Hash01(PixelKey, Seed ^ FrameIndex, 7u) < 0.5, Offset);
				LastEv = TUs;
			}
		}
	}

	StateTexture[P]     = float4(Ref, Lp1, Lp2, LCur);
	LastEventTexture[P] = LastEv;
}
